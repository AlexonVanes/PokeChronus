    border-color: #36d4ff99
    color: #e8fbff
    text: MISSOES
    text-align: center
    font: damas
    anchors.top: actionDock.top
    anchors.left: actionDock.left
    margin-left: 8
    margin-top: 6
    opacity: 0.8
    @onClick: modules.game_pass.showMissions()
    $hover:
      opacity: 1.0
      border-color: #36d4ffff
      background-color: #0f3650ee
    
    $pressed:
      opacity: 0.9
  UIButton
    id: buyPassButton
    image-source: ~
    size: 124 30
    background-color: #0b2638dd
    border-width: 1
    border-color: #ffd44faa
    color: #ffdd62
    text: ATUALIZAR
    text-align: center
    font: damas
    anchors.top: missions.top
    anchors.left: missions.right
    margin-left: 8
    !tooltip: tr('Comprar Passe - 50 diamonds')
    opacity: 0.8
    @onClick: modules.game_pass.showBuyPassElite()
    $hover:
      opacity: 1.0
      border-color: #ffd44fff
      background-color: #17344bee

    $pressed:
      opacity: 0.9
  UIButton
    id: passLeveuUp
    image-source: images/add_level
    size: 33 16
    anchors.bottom: parent.bottom
    anchors.left: levelLabel.right
    margin-left: 100
    margin-bottom: 56
    !tooltip: tr('Comprar nivel do passe')
    opacity: 0.8
    @onClick: showUpWindow()
    $hover:
      opacity: 1.0
    
    $pressed:
      opacity: 0.9
  horizontal-scrollbar: itemsScrollBar

