MissionWidget < UIWidget
  size: 168 136
  image-source: ~
  background-color: #061923dd
  border: 1 #0d9fd0bb

  UIWidget
    id: topGlow
    height: 2
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #ffd43b

  UIWidget
    id: base
    size: 92 48
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 43
    image-source: images/mission/base
  UIWidget
    id: itemIcon
    size: 44 44
    anchors.centerIn: base
    phantom: true
  UIWidget
    id: progressTrack
    size: 118 6
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 25
    margin-bottom: 30
    background-color: #000000cc
    border: 1 #17475d
  UIWidget
    id: progressFill
    size: 1 4
    anchors.left: progressTrack.left
    anchors.verticalCenter: progressTrack.verticalCenter
    margin-left: 1
    background-color: #ffd43b
  UIWidget
    id: xpicon
    size: 21 17
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 8
    margin-left: 9
    image-source: images/mission/xp_icon
  UIWidget
    id: xptext
    size: 48 15
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 8
    margin-left: 32
    text-align: left
    font: damas
    color: #ffffff
  UIWidget
    id: star
    size: 18 18
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 7
    margin-right: 10
    font: damas
    image-source: images/mission/loading
    $on:
      image-source: images/mission/complet
  UIWidget
    id: progress
    size: 168 18
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 20
    text-align: center
    font: damas
    color: #ffffff
  UIWidget
    id: desc
    size: 148 34
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 10
    text-align: topLeft
    text-wrap: true
    font: damas
    color: #ffffff

tittleMissions < UIWidget
  id: tittleMissions
  size: 520 34
  image-source: ~
  background-color: #061923ee
  border: 1 #0d9fd0bb
  anchors.top: parent.top
  anchors.right: parent.right
  visible: false
  margin-top: 58
  margin-right: 15
  UIWidget
    id: titleAccent
    width: 4
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    background-color: #ffd43b
  Label
    id: missionTitle
    text: MISSOES DO PASSE
    text-auto-resize: true
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 18
    color: #b9f4ff
    font: window
  Label
    id: missionTag
    text: DIARIAS E SEMANAIS
    text-auto-resize: true
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 14
    color: #ffd43b
    font: damas
backgroundMissions < UIWidget
  id: backgroundMissions
  size: 245 288
  image-source: images/mission/background_image
  anchors.top: parent.top
  anchors.left: parent.left
  visible: false
  margin-left: 55
  margin-top: 124

MissionPanel < UIScrollArea
  id: missionPanel
  size: 520 284
  anchors.top: parent.top
  anchors.right: parent.right
  margin-top: 104
  margin-right: 15
  visible: false
  layout:
    type: grid
    cell-size: 168 136
    flow: true
    cell-spacing: 8
  vertical-scrollbar: missionScrollBar
MissionScrollBar < VerticalScrollBar
  id: missionScrollBar
  anchors.top: missionPanel.top
  anchors.bottom: missionPanel.bottom
  anchors.left: missionPanel.right
  margin-left: 7
  step: 30
  opacity: 0.7
  visible: false
MissionClose < UIButton
  id: returnMission
  size: 88 28
  anchors.bottom: parent.bottom
  anchors.right: parent.right
  margin-right: 44
  margin-bottom: 30
  image-source: ~
  background-color: #061923ee
  border: 1 #ffd43b
  color: #ffd43b
  text: VOLTAR
  text-offset: 0 1
  font: window
  change-cursor-image: true
  cursor: pointer
  @onClick: modules.game_pass.hideMissions()
  visible: false
  opacity: 0.8
  $hover:
    opacity: 1
  $pressed:
    opacity: 0.9

CollectedMask < UIWidget
  size: 64 77
  //anchors.fill: parent
  anchors.bottom: parent.bottom
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  margin-bottom: -13
  margin-top: -13
  margin-left: -13
  margin-right: -13
  image-source: images/collected
  phantom: true
PassWidgetLevel < UIWidget
  width: 64
  height: 20
  image-source: ~
  background-color: #061a2add
  border-width: 1
  border-color: #1da7ff88
  color: #ffffff
  text-align: center
  font: damas
  $hover:
    border-color: #ffd44faa
UIPassExperience < UIWidget
  size: 64 77
  padding: 13
  image-source: images/experience
UIPassPremiumPoints < UIWidget
  size: 64 77
  padding: 13
  color: white
  font: damas
  text-offset: 40 55
  image-source: images/premiumpoints
UIPassSkin < UICreature
  size: 64 77
  padding: 13
  fixed-creature-size: true
UIPassItem < UIWidget
  size: 64 77
  padding: 13
  image-source: images/slot
  background-color: #03142199
  border-width: 1
  border-color: #103a55aa
  opacity: 0.9
  $hover:
    opacity: 1
    border-color: #ffd44fcc
  $pressed:
    opacity: 0.5
  Item
    id: item
    anchors.fill: parent
    anchors.bottom: parent.bottom
    margin-bottom: 6
    phantom: true
    virtual: true
UIPassMask < UIWidget
  size: 64 77
  image-source: ~
  background-color: black
  opacity: 0.5
  phantom: true
  anchors.bottom: parent.bottom
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  margin-bottom: -10
  margin-top: -10
  margin-left: -10
  margin-right: -10
StarWidget < UIWidget
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 1
  margin-left: 2
  image-source: images/progress/0

  $!first:
    image-source: images/progress/0
    margin-left: 0

UIBlackWindow < UIWidget
  id: UIBlackWindow
  size: 827 429
  image-source: images/blackwindow
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: -30
  margin-left: -9
  visible: false

AlertWindow < UIWidget
  id: AlertWindow
  size: 360 150
  image-source: ~
  background-color: #02111bf2
  border-width: 1
  border-color: #168fc0cc
  anchors.centerIn: parent
  margin-bottom: 18
  @onEscape: hideAlertWindow()
  visible: false
  UIWidget
    id: topLine
    height: 3
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #35cfff
  UIWidget
    id: accentLine
    width: 4
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-bottom: 14
    margin-left: 14
    background-color: #ffd44f
  UIWidget
    id: iconFrame
    size: 74 74
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 28
    margin-left: 30
    background-color: #031823ee
    border-width: 1
    border-color: #35cfff77
  UIWidget
    id: icon
    size: 52 52
    anchors.centerIn: iconFrame
  Label
    id: alertTitle
    !text: tr('AVISO')
    font: damas
    color: #ffd95a
    anchors.top: parent.top
    anchors.left: iconFrame.right
    margin-top: 30
    margin-left: 18
    text-auto-resize: true
  UIWidget
    id: alertLine
    size: 185 3
    image-source: images/separator_vertical
    anchors.top: alertTitle.bottom
    anchors.left: alertTitle.left
    margin-top: 3
  Label
    id: alertMessage
    size: 206 34
    !text: tr('Mensagem do passe.')
    font: verdana-11px-rounded
    color: #d8f4ff
    anchors.top: alertLine.bottom
    anchors.left: alertTitle.left
    margin-top: 8
    text-wrap: true
  UIWidget
    id: text
    visible: false
  UIButton
    id: cancelar
    image-source: ~
    size: 124 30
    background-color: #0b2638dd
    border-width: 1
    border-color: #35cfff99
    color: #e8fbff
    text: FECHAR
    text-align: center
    font: damas
    anchors.bottom: parent.bottom
    anchors.left: alertTitle.left
    margin-bottom: 14
    opacity: 0.8
    @onClick: hideAlertWindow()
    $hover:
      opacity: 1.0
      border-color: #35cfffff
      background-color: #0f3650ee
    
    $pressed:
      opacity: 0.9

