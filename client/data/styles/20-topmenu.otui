TopButton < UIButton
  size: 52 52
  color: alpha
  icon-color: alpha
  change-cursor-image: true
  cursor: pointer
  @onSetup: |
    connect(self, {
      onHoverChange = function(self, hovered)
        self:getParent():getParent().hideMenu:setChecked(hovered)
      end
    })

  UIWidget
    id: topButtonIcon
    size: 28 28
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    image-size: 28 28
    image-color: #ffffff
    phantom: true

  Label
    id: topButtonLabel
    height: 12
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 3
    font: small-9px
    color: #ffffff
    text-align: center
    text-auto-resize: false
    phantom: true

  $on:
    color: alpha
    icon-color: alpha

  $hover !disabled:
    color: alpha
    icon-color: alpha

  $pressed:
    color: alpha
    icon-color: alpha

  $disabled:
    color: alpha
    icon-color: alpha
    change-cursor-image: false

TopMenuButtonsPanel < Panel
  layout:
    type: horizontalBox
    spacing: 3
    fit-children: true

TopMenuPanel < UIWidget
  size: 120 64
  image-source: /images/ui/topmenu
  image-color: #090910e6
  image-border: 20
  focusable: false
  margin-top: 0
  @onHoverChange: |
    function(self, hovered)
      self.hideMenu:setChecked(hovered)
    end

  $on:
    margin-top: -64

TopMenuHide < UIWidget
  size: 62 24
  anchors.top: topMenu.bottom
  anchors.horizontalCenter: topMenu.horizontalCenter
  image-source: /images/ui/topmenu_hide
  focusable: false
  opacity: 0
  @onClick: modules.client_topmenu.showAndHide()
  icon: /images/ui/scroll_arrow
  icon-clip: 0 38 19 19
  change-cursor-image: true
  cursor: pointer

  $hover:
    opacity: 1

  $on:
    opacity: 0.4
    icon-clip: 0 57 19 19

  $on hover:
    opacity: 1

  $checked:
    opacity: 1

  $disabled:
    change-cursor-image: false

TopMenuFrameCounterLabel < Label
  anchors.top: parent.top
  anchors.left: parent.left
  font: righteous-12px-rounded-solid
  text-auto-resize: true
  color: alpha
  margin: 5
  visible: false

  $on:
    color: white

TopMenuPingLabel < Label
  font: righteous-12px-rounded-solid

TopMenu < TopMenuPanel
  id: topMenu
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.top: parent.top
  padding: 6

  TopMenuButtonsPanel
    id: leftButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 16

  TopMenuButtonsPanel
    id: leftGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    visible: false

  VerticalSeparator
    id: leftGameSeparator
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 7

  TopMenuButtonsPanel
    id: rightButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-left: 7

  VerticalSeparator
    id: rightGameSeparator
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 7

  TopMenuButtonsPanel
    id: rightGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-left: 7
    visible: false
